# Normalise to LF in the repository; check out native on Windows.
* text=auto

*.cs        text diff=csharp
*.csproj    text
*.props     text
*.sln       text eol=crlf
*.slnx      text
*.json      text
*.ts        text
*.html      text
*.scss      text
*.md        text
*.yml       text
*.yaml      text
*.sh        text eol=lf
*.ps1       text eol=crlf

*.png       binary
*.jpg       binary
*.ico       binary
