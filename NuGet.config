<?xml version="1.0" encoding="utf-8"?>
<configuration>

  <!-- design: doc 08 section 7.1 - every CI run audits dependencies. This file closes the gap
       that audit cannot see: WHERE a package came from. Without it, restore inherits whatever
       feeds happen to be configured on the machine or the build agent, which is how a package
       resolves from an unexpected source without anyone noticing. -->

  <!-- <clear /> first, so machine and user level NuGet.config files cannot add a feed to this
       repository. Everything FTMS restores comes from the one source named below. -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>

  <!-- Package source mapping. With a single source this looks like ceremony, and today it is:
       the value is that adding a second feed later becomes a deliberate act. A new source
       serves nothing until a pattern here says it may, which is the control that defeats
       dependency confusion - an internal package name claimed on a public feed. -->
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>

  <!-- Fail the restore rather than silently accept a package that is unsigned or signed by an
       unexpected author. -->
  <config>
    <add key="signatureValidationMode" value="require" />
  </config>

  <!-- Required by the setting above, and its absence was a latent build break rather than a
       stricter policy. "require" with no trusted signers trusts NOBODY, so it rejects every
       package it actually has to download - it simply went unnoticed for as long as every
       package the solution needed was already in the machine's global cache. The first new
       dependency, on the first cold agent, would have failed the build with an error that reads
       like a supply chain compromise.

       These are nuget.org's own repository signing certificates, three because the certificate
       has been rotated twice and packages signed under an older one must keep validating.
       Written by `dotnet nuget trust source nuget.org`, which reads them from the service index,
       rather than transcribed by hand. -->
  <trustedSigners>
    <repository name="nuget.org" serviceIndex="https://api.nuget.org/v3/index.json">
      <certificate fingerprint="0e5f38f57dc1bcc806d8494f4f90fbcedd988b46760709cbeec6f4219aa6157d" hashAlgorithm="SHA256" allowUntrustedRoot="false" />
      <certificate fingerprint="5a2901d6ada3d18260b9c6dfe2133c95d74b9eef6ae0e5dc334c8454d1477df4" hashAlgorithm="SHA256" allowUntrustedRoot="false" />
      <certificate fingerprint="1f4b311d9acc115c8dc8018b5a49e00fce6da8e2855f9f014ca6f34570bc482d" hashAlgorithm="SHA256" allowUntrustedRoot="false" />
    </repository>
  </trustedSigners>

</configuration>
